# Shopify app credentials. The Shopify CLI injects these automatically during
# `npm run dev`; fill them in only for manual or production deployments
# (values are in your Partner dashboard after `shopify app config link`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# OAuth scopes. Must match [access_scopes] in shopify.app.toml.
# read_products: product copy + metafields; read_translations: Translate & Adapt
# content; read_locales: published locales for variant URLs; read_orders:
# experiment metrics; write_files: illustrations stored in the store's Files.
# The app never writes to products.
SCOPES=read_products,read_translations,read_locales,read_orders,write_files

# Anthropic API key — required for variant generation and the claim guard.
ANTHROPIC_API_KEY=

# Claude model used for generation and the claim guard.
PAGE_TAILOR_MODEL=claude-opus-4-8

# Optional: Claude model for the illustration recommender and figure
# placement (defaults to PAGE_TAILOR_MODEL).
# PAGE_TAILOR_FIGURE_MODEL=

# OpenAI API key — required only for drawing illustrations (the image
# library, uploads and everything else work without it).
OPENAI_API_KEY=

# Optional: OpenAI image model (default gpt-image-2.5-sunburst).
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
