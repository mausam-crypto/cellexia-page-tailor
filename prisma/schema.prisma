// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

// Per-shop configuration: which copy surfaces may be adapted and how they map
// onto the storefront DOM. Surfaces are stored as a JSON array of
// { key, label, source, namespace?, metafieldKey?, selector, mode }.
model ShopSettings {
  shop           String   @id
  paramName      String   @default("cx")
  intensity      String   @default("light") // light | medium
  surfaces       String   @default("[]")
  // Subtle-intent mode dials as a JSON object (SubtleModeSettings); "{}"
  // means every dial at its conservative default. Read at generation time.
  subtleSettings String   @default("{}")
  // Illustration settings as JSON (IllustrationSettings): drawing quality,
  // optional monthly spending cap, house-style text, remembered form choices.
  illustrationSettings String @default("{}")
  // Master kill switch. OFF by default: a fresh install never changes
  // anything on the storefront until the merchant explicitly enables serving.
  servingEnabled Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

// A reusable drawing style for AI illustrations: category + "when to use"
// are what the recommender reads; instructions are prepended to the
// specific prompt of every drawing made with the template.
model IllustrationTemplate {
  id             String   @id @default(cuid())
  shop           String
  // Stable key of a starter template (null for merchant-created ones), so
  // the starter set can be seeded once per shop and never re-created after
  // the merchant deletes or edits it.
  seedKey        String?
  name           String
  category       String
  whenToUse      String
  instructions   String
  shape          String   @default("landscape") // landscape | square | portrait
  exampleImageId String?
  exampleImage   IllustrationImage? @relation("TemplateExample", fields: [exampleImageId], references: [id], onDelete: SetNull)
  sortOrder      Int      @default(0)
  archived       Boolean  @default(false)
  images         IllustrationImage[] @relation("DrawnFromTemplate")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, seedKey])
  @@index([shop])
}

// One illustration in the shop's library: uploaded by the merchant or drawn
// by the image model. The file itself lives in the store's Shopify Files
// (CDN); this row holds its coordinates plus, for drawn images, everything
// needed to draw it again.
model IllustrationImage {
  id               String   @id @default(cuid())
  shop             String
  kind             String   // upload | drawn
  name             String
  description      String   @default("") // "what it shows"; read by the recommender and the placement pass
  tags             String   @default("[]") // JSON string[]
  language         String?  // optional locale tag (labels inside the image are in this language)
  shopifyFileId    String   // gid://shopify/MediaImage/...
  cdnUrl           String
  width            Int
  height           Int
  mimeType         String
  bytes            Int?
  // Drawn images only.
  templateId       String?
  template         IllustrationTemplate? @relation("DrawnFromTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  specificPrompt   String?
  finalPrompt      String?
  rationale        String?
  model            String?
  quality          String?
  size             String?
  costUsd          Float?
  sourceArticleId  String?  // informational only (the variant may be deleted later)
  sourceSurfaceKey String?
  overrides        Override[]
  exampleOf        IllustrationTemplate[] @relation("TemplateExample")
  charges          IllustrationCharge[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([shop, kind])
}

// Ledger of billed image-model calls (one row per drawing attempt that was
// charged, including a drawing whose upload to Shopify then failed). The
// month's illustration spend is the sum of costUsd since the first of the
// month (UTC).
model IllustrationCharge {
  id           String   @id @default(cuid())
  shop         String
  imageId      String?
  image        IllustrationImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  articleId    String?
  surfaceKey   String?
  model        String
  quality      String
  size         String
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float
  // True when the API returned no usage figures and the cost is a table
  // estimate rather than the exact amount.
  estimated    Boolean  @default(false)
  status       String   // ok | upload_failed
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
}

// One row per (day, product, locale): storefront page views recorded by the
// theme embed's beacon. variantViews counts views with variant CONTEXT: an
// arrival via a well-formed ?cx value OR a return visit carried by the
// visitor's browser-stored preference. It does not verify that a variant was
// served or applied, so it keeps counting while serving is switched off.
model DailyStat {
  id            String @id @default(cuid())
  shop          String
  dateKey       String // YYYY-MM-DD, UTC
  productHandle String
  locale        String
  views         Int    @default(0)
  variantViews  Int    @default(0)

  @@unique([shop, dateKey, productHandle, locale])
  @@index([shop, productHandle])
}

// One row per (order, product) for products under experiment, synced on
// demand from the Admin API. Amounts are in the shop currency.
model OrderLine {
  id             String  @id @default(cuid())
  shop           String
  orderId        String
  productId      String // product GID
  dateKey        String // YYYY-MM-DD, UTC (order created_at)
  units          Int
  lineRevenue    Float
  orderTotal     Float
  customerLocale String?

  @@unique([orderId, productId])
  @@index([shop, productId, dateKey])
}

// A sequential baseline/treatment comparison for one product + locale.
// NOT an A/B test: the two windows are consecutive time periods and only one
// version of the page is ever live for a given market at a time.
model Experiment {
  id              String    @id @default(cuid())
  shop            String
  productId       String
  productHandle   String
  productTitle    String
  locale          String
  status          String    @default("running") // running | completed | stopped
  baselineStart   DateTime
  baselineEnd     DateTime // == treatmentStart
  treatmentStart  DateTime
  treatmentEnd    DateTime
  stoppedAt       DateTime?
  stopReason      String?
  lastOrderSyncAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([shop, status])
}

// One row per marketing article. Each approved article yields exactly one
// variant URL: {product url}?{paramName}={variantHandle}.
model Article {
  id            String     @id @default(cuid())
  shop          String
  productId     String // Shopify product GID
  productHandle String
  productTitle  String
  locale        String // shop locale code, e.g. "en", "fr"
  sourceUrl     String?
  sourceTitle   String?
  sourceText    String? // extracted article body used for analysis
  // How the source was supplied: "article" (fetched from sourceUrl),
  // "pasted" (article text pasted by hand), or "brief" (a merchant-written
  // campaign brief; there is no article at all).
  sourceKind    String     @default("article") // article | pasted | brief
  // Brief-sourced variants only: the brief as typed, an optional reference
  // box (pasted text and/or one URL per line; re-read on every run), and
  // the optional structured "advanced" fields as JSON
  // ({ audience?, keyMessage?, tone?, mustSay?, mustAvoid? }).
  briefName       String?
  briefText       String?
  briefReferences String?
  briefAdvanced   String?
  // A refinement instruction waiting for the background queue. When set,
  // the next run edits the CURRENT copy per this instruction instead of
  // regenerating from the base copy. Every enqueue writes this column
  // explicitly (instruction or null), so a value left behind by a crashed
  // run can never be mis-applied by a later plain generation.
  pendingRefinement String?
  // Illustration choices made in the creation form, per surface key
  // (IllustrationPlan JSON): none / auto / a library image / a template with
  // one or more prompts to draw. Read by the figure phase that follows
  // every generation from the base copy.
  illustrationPlan  String?
  // A figure job waiting for the background queue (FigureJob JSON): draw or
  // place an illustration without touching the copy. Written explicitly on
  // every enqueue, like pendingRefinement.
  pendingFigureJob  String?
  detectedQuery String?
  queryVariants String? // JSON string[]
  evidence      String? // JSON string[] of article phrases supporting the query inference
  status        String     @default("pending") // pending | generated | approved | archived | error
  errorMessage  String?
  // In-flight generation lock: set while a generation runs so concurrent
  // runs are rejected and save/markReviewed are blocked against copy in
  // motion. Locks older than 15 minutes are treated as stale (crashed run).
  generatingAt  DateTime?
  // Waiting in the server-side generation queue. Generations run in the
  // background (several in parallel) and survive the admin closing the page.
  queuedAt      DateTime?
  // True once the article has ever been live: lets the UI distinguish
  // "taken offline" from "never live".
  wasApproved   Boolean    @default(false)
  // Post-publication review model: generation puts the variant live
  // immediately and resets reviewedAt to null; the merchant is notified and
  // marks it reviewed (or takes it offline). Null = live awaiting review.
  reviewedAt    DateTime?
  // Adaptation mode, set per URL batch at creation (flippable per article;
  // takes effect at generation):
  // standard | subtle | meta | ultra | persona | max | v2.
  // subtle keeps standard's conservatism but plants a dial-budgeted number
  // of concern-positioning sentences (unprompted-brand test, no proof
  // elements); meta pulls the article's proof elements (study wins,
  // rankings, stats); ultra rewrites deepest for the article's audience
  // intent/use case, may remove irrelevant claims, but never pulls proof
  // elements; persona is ultra plus a ranked audience-desire list driving
  // placement; v2 writes the page as the article's sequel (expectations/
  // redundancy/ceded ground/gaps inventories with moderate stage-matched
  // compression).
  mode          String     @default("standard")
  // Snapshot of mode at last generation: edit-time finding reclassification
  // must follow the mode the stored copy was generated under, not the live
  // toggle (which only affects the next generation).
  generatedMode String     @default("standard")
  proofPoints   String? // JSON [{claim, quote, verified}]: article proof elements used in meta mode
  personaPriorities String? // JSON [{point, importance}]: deep-persona ranked desire list
  conversionPlan    String? // JSON ConversionPlan: conversion-max reader stage + 3 ranked lists
  v2Plan            String? // JSON V2Plan: Ultra Custom V2 inventories + reader stage + length decision
  subtlePlan        String? // JSON SubtlePlan: subtle-intent concern + term decision + insertions
  variantHandle String     @unique // opaque slug used in the public URL
  overrides     Override[]
  versions      VariantVersion[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([shop, productId, locale])
  @@index([shop, status])
}

// One adapted copy surface within an article's variant.
model Override {
  id         String  @id @default(cuid())
  articleId  String
  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  surfaceKey String
  label      String
  selector   String
  mode       String // "text" | "html"
  original   String
  adapted    String
  notes         String?
  warnings      String? // JSON string[]: unsupported claims + risky patterns; shown as "Flagged for review" (post-publication model: nothing blocks)
  articleClaims String? // JSON string[]: new claims grounded in the source article (or, for briefs, in the brief/references); shown for review
  // Brief-sourced variants only: claims the guard found in none of the page
  // copy, the brief, or the references. Informational ("unverified, check
  // before launch"); never blocks. Untouched by hand edits until the next
  // generation or refinement replaces the row.
  unverifiedClaims String? // JSON string[]
  enabled       Boolean @default(true)
  // Illustration placed in this surface. It renders at the
  // <div data-pt-figure> marker inside `adapted` (at the top of the section
  // when the marker is missing). Restrict: a library image in use on a live
  // page cannot be deleted.
  figureImageId      String?
  figureImage        IllustrationImage? @relation(fields: [figureImageId], references: [id], onDelete: Restrict)
  figureCaption      String?
  figureAlt          String?
  figureAlternatives String? // JSON FigureAlternatives: other drawn images + un-drawn suggestions
  figureSource       String? // library | drawn | auto
  figureError        String? // why the last drawing/placement failed; shown on the review page
  figureLastJob      String? // JSON SurfaceFigureJob of the last attempt, for "Try again"

  @@unique([articleId, surfaceKey])
}

// Append-only history of a variant's copy. One row per event that changed
// the live Override rows (generation, refinement, hand edit, restore,
// duplicate), holding a full snapshot of every surface right AFTER the
// event. Override stays the live copy that serving reads; restoring a
// version copies its snapshot back into fresh Override rows.
model VariantVersion {
  id              String   @id @default(cuid())
  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  number          Int // 1-based, per article
  kind            String // generate | refine | edit | restore | duplicate | figure
  // refine: the merchant's instruction; edit: "Edited: <labels>";
  // duplicate: "Duplicated from <name>"; generate/restore: null.
  instruction     String?
  surfaces        String // JSON SurfaceSnapshot[]: the live state right after this event
  modelNotes      String? // generate/refine: the model's summary of what it changed
  runWarnings     String? // JSON string[]: e.g. reference URLs that could not be read
  changedSurfaces String? // JSON string[] of surface labels that differ from the previous version
  restoredFrom    Int? // restore: the version number that was restored
  createdAt       DateTime @default(now())

  @@unique([articleId, number])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
